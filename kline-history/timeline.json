  },
  {
   "i": 1,
   "scene": "open",
   "sub": "满屏都是同一种红绿蜡烛。",
   "start": 7.232,
   "end": 10.804
  },
  {
   "i": 2,
   "scene": "open",
   "sub": "无论哪个国家、交易什么资产，|人们都在看【同一种图表】。",
   "start": 11.304,
   "end": 16.636
  },
  {
   "i": 3,
   "scene": "open",
   "sub": "这件每天左右数万亿资金流向的工具，|起源于三百年前东方的一场【大米博弈】。",
   "start": 17.136,
   "end": 24.668
  },
  {
   "i": 4,
   "scene": "dojima",
   "sub": "十八世纪，日本江户时代。大阪是“天下的厨房”，|大米就是财富。",
   "start": 34.168,
   "end": 40.14
  },
  {
   "i": 5,
   "scene": "dojima",
   "sub": "各地大名把年贡米运到大阪发售，换成金银。",
   "start": 40.64,
   "end": 45.132
  },
  {
   "i": 6,
   "scene": "dojima",
   "sub": "1730年，幕府正式认可大阪【堂岛米会所】。",
   "start": 45.632,
   "end": 50.524
  },
  {
   "i": 7,
   "scene": "dojima",
   "sub": "商人交易的不是现米，而是代表大米的票据——|米切手。",
   "start": 51.024,
   "end": 56.196,
   "pos": "L",
   "y": 300,
   "size": 58
  },
  {
   "i": 8,
   "scene": "dojima",
   "sub": "更有不交割现货、|只按约定价格结算差额的|“账合米”交易：|人类最早的【期货市场】之一。",
   "start": 56.696,
   "end": 64.468,
   "pos": "R",
   "y": 280,
   "size": 54
  },
  {
   "i": 9,
   "scene": "dojima",
   "sub": "天灾、歉收、饥荒，让米价暴涨暴跌。",
   "start": 64.968,
   "end": 68.66
  },
  {
   "i": 10,
   "scene": "dojima",
   "sub": "商人们急需一本，能看清价格波动规律的【账本】。",
   "start": 69.16,
   "end": 74.612
  },
  {
   "i": 11,
   "scene": "homma",
   "sub": "出羽国酒田的米商——本间宗久。",
   "start": 77.712,
   "end": 81.644,
   "pos": "C",
   "y": 540,
   "size": 76
  },
  {
   "i": 12,
   "scene": "homma",
   "sub": "相传他发现：决定米价的不只是供需，|更是买卖双方的【恐惧与贪婪】。",
   "start": 82.144,
   "end": 88.476
  },
  {
   "i": 13,
   "scene": "homma",
   "sub": "本间家成为江户时代屈指可数的巨富，民间传唱：",
   "start": 88.976,
   "end": 93.788
  },
  {
   "i": 14,
   "scene": "homma",
   "sub": "“比不上本间家，|至少也想当个大名。”",
   "start": 94.288,
   "end": 99.061,
   "pos": "C",
   "y": 520,
   "size": 60
  },
  {
   "i": 15,
   "scene": "homma",
   "sub": "相传成书于1755年的《三猿金泉录》，|记下了他观察米市的心法。",
   "start": 99.561,
   "end": 106.013
  },
  {
   "i": 16,
   "scene": "homma",
   "sub": "后世据此整理出“酒田战法”：|用蜡烛的形状，判断多空的心理。",
   "start": 106.513,
   "end": 112.685
  },
  {
   "i": 17,
   "scene": "homma",
   "sub": "三山：|三次冲高不过，|顶部成形。",
