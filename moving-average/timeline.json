   "size": 70
  },
  {
   "i": 7,
   "scene": "origin",
   "sub": "二战之后，美国军方的预测研究，|需要更快地跟踪目标与需求。",
   "start": 54.0,
   "end": 60.1
  },
  {
   "i": 8,
   "scene": "origin",
   "sub": "罗伯特·布朗等人提出【指数平滑】：|越新的数据，权重越大。",
   "start": 60.6,
   "end": 66.78
  },
  {
   "i": 9,
   "scene": "origin",
