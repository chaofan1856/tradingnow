{
 "total": 310.561,
 "fps": 30,
 "lines": [
  {
   "i": 0,
   "scene": "open",
   "sub": "你每天盯着的K线，红与绿，涨与跌。",
   "start": 2.6,
   "end": 6.09
  },
  {
   "i": 1,
   "scene": "open",
   "sub": "它看上去，只是屏幕上跳动的数字。",
   "start": 6.59,
   "end": 11.054
  },
  {
   "i": 2,
   "scene": "open",
   "sub": "可在它背后，那场【博弈】已经进行了五千年。",
   "start": 11.404,
   "end": 16.931
  },
  {
   "i": 3,
   "scene": "sumer",
   "sub": "五千年前，美索不达米亚平原。",
   "start": 27.531,
   "end": 31.295
  },
  {
   "i": 4,
   "scene": "sumer",
   "sub": "最早的金融机构，不是私人银行，而是【神庙】。",
   "start": 31.745,
   "end": 37.187
  },
  {
   "i": 5,
   "scene": "sumer",
   "sub": "春播时，农民从神庙借走大麦；",
   "start": 37.587,
   "end": 41.888
  },
  {
   "i": 6,
   "scene": "sumer",
   "sub": "秋收后，【连本带息】归还。",
   "start": 42.088,
   "end": 45.39
  },
  {
   "i": 7,
   "scene": "sumer",
   "sub": "每一笔契约，都被刻进楔形文字泥板——",
   "start": 45.79,
   "end": 50.904
  },
  {
   "i": 8,
   "scene": "sumer",
   "sub": "本金、利息，还有违约的惩罚。",
   "start": 51.054,
   "end": 54.643
  },
  {
   "i": 9,
   "scene": "sumer",
   "sub": "五千年前的人类就已明白：【时间】，是有价值的。",
   "start": 55.143,
   "end": 60.07
  },
  {
   "i": 10,
   "scene": "sumer",
   "sub": "而利息，正是时间的【价格】。",
   "start": 60.42,
   "end": 63.81
  },
  {
   "i": 11,
   "scene": "sumer",
   "sub": "今天的【杠杆】与【期权】，",
   "start": 64.26,
   "end": 66.745
  },
  {
   "i": 12,
   "scene": "sumer",
   "sub": "不过是这块泥板，跨越五千年的回声。",
   "start": 66.845,
   "end": 71.319
  },
  {
   "i": 13,
   "scene": "babylon",
   "sub": "一千年后，古巴比伦。",
   "start": 73.419,
   "end": 76.45
  },
  {
   "i": 14,
   "scene": "babylon",
   "sub": "从《埃什南纳法典》到《汉谟拉比法典》，",
   "start": 76.85,
   "end": 81.28
  },
  {
   "i": 15,
   "scene": "babylon",
   "sub": "人类第一次用【成文法】，约束金融。",
   "start": 81.43,
   "end": 85.502
  },
  {
   "i": 16,
   "scene": "babylon",
   "sub": "大麦借贷，年息不得超过三分之一；",
   "start": 85.952,
   "end": 90.193
  },
  {
   "i": 17,
   "scene": "babylon",
   "sub": "白银借贷，不得超过【百分之二十】。",
   "start": 90.393,
   "end": 94.345
  },
  {
   "i": 18,
   "scene": "babylon",
   "sub": "世上，从来没有绝对自由的市场。",
   "start": 94.795,
   "end": 98.743
  },
  {
   "i": 19,
   "scene": "babylon",
   "sub": "涨跌停板、保证金、强制平仓——",
   "start": 99.193,
   "end": 103.02
  },
  {
   "i": 20,
   "scene": "babylon",
   "sub": "四千年前，就已有了【秩序】的雏形。",
   "start": 103.17,
   "end": 107.359
  },
  {
   "i": 21,
   "scene": "zhou",
   "sub": "在东方，商周以贝作币，又用青铜铸贝。",
   "start": 113.059,
   "end": 118.151
  },
  {
   "i": 22,
   "scene": "zhou",
   "sub": "到了春秋战国，民间借贷盛行。",
   "start": 118.551,
   "end": 122.823
  },
  {
   "i": 23,
   "scene": "zhou",
   "sub": "齐国管仲，以【轻重之术】吞吐天下；",
   "start": 123.223,
   "end": 127.696
  },
  {
   "i": 24,
   "scene": "zhou",
   "sub": "魏国李悝，行平籴之法，调节余缺。",
   "start": 127.896,
   "end": 132.979
  },
  {
   "i": 25,
   "scene": "zhou",
   "sub": "国家亲自放贷、收储、平抑物价——",
   "start": 133.379,
   "end": 136.476
  },
  {
   "i": 26,
   "scene": "zhou",
   "sub": "像极了今天的逆回购、平准基金与政策性贷款。",
   "start": 136.626,
   "end": 142.127
  },
  {
   "i": 27,
   "scene": "zhou",
   "sub": "金融，从来都是【治理】的终极工具。",
   "start": 142.577,
   "end": 146.5
  },
  {
   "i": 28,
   "scene": "tang",
   "sub": "唐代，商人在长安，把铜钱交给各道进奏院，",
   "start": 148.6,
   "end": 154.501
  },
  {
   "i": 29,
   "scene": "tang",
   "sub": "换回一纸凭券；到了异地，合券取钱。",
   "start": 154.651,
   "end": 159.482
  },
  {
   "i": 30,
   "scene": "tang",
   "sub": "这，就是【飞钱】。",
   "start": 159.832,
   "end": 162.192
  },
  {
   "i": 31,
   "scene": "tang",
   "sub": "信用第一次挣脱了铜钱的重量，在空间中【流动】。",
   "start": 162.542,
   "end": 168.014
  },
  {
   "i": 32,
   "scene": "song",
   "sub": "北宋，蜀地出现了【交子】——世界上最早的纸币。",
   "start": 169.914,
   "end": 175.096
  },
  {
   "i": 33,
   "scene": "song",
   "sub": "货币，不再依赖金属本身的价值，",
   "start": 175.496,
   "end": 179.421
  },
  {
   "i": 34,
   "scene": "song",
   "sub": "而建立在【信用】之上。",
   "start": 179.571,
   "end": 181.992
  },
  {
   "i": 35,
   "scene": "song",
   "sub": "信用，从此彻底【符号化】。",
   "start": 182.292,
   "end": 185.544
  },
  {
   "i": 36,
   "scene": "piaohao",
   "sub": "明清，山西票号【汇通天下】，",
   "start": 187.444,
   "end": 191.435
  },
  {
   "i": 37,
   "scene": "piaohao",
   "sub": "以联号与密押，织成一张全国的汇兑网络。",
   "start": 191.585,
   "end": 197.054
  },
  {
   "i": 38,
   "scene": "piaohao",
   "sub": "大额银两，不必再靠镖车翻山越岭。",
   "start": 197.354,
   "end": 201.105
  },
  {
   "i": 39,
   "scene": "chain",
   "sub": "从飞钱，到交子，再到票号——",
   "start": 202.805,
   "end": 206.341
  },
  {
   "i": 40,
   "scene": "chain",
   "sub": "中国古代金融史，是一部【效率】的进化史：",
   "start": 206.541,
   "end": 211.461
  },
  {
   "i": 41,
   "scene": "chain",
   "sub": "不断提升流动性，不断降低交易成本。",
   "start": 211.611,
   "end": 216.165
  },
  {
   "i": 42,
   "scene": "chain",
   "sub": "正如今天，从电汇，走向【数字资产】。",
   "start": 216.465,
   "end": 220.746
  },
  {
   "i": 43,
   "scene": "voc",
   "sub": "直到【1602】年，阿姆斯特丹。",
   "start": 226.246,
   "end": 230.396
  },
  {
   "i": 44,
   "scene": "voc",
   "sub": "荷兰东印度公司成立，向所有人发售股份。",
   "start": 230.846,
   "end": 235.864
  },
  {
   "i": 45,
   "scene": "voc",
   "sub": "第一家上市公司，第一家证券交易所，就此诞生。",
   "start": 236.214,
   "end": 242.455
  },
  {
   "i": 46,
   "scene": "voc",
   "sub": "所有权与经营权分离，普通人也能参与宏大的博弈。",
   "start": 242.855,
   "end": 248.454
  },
  {
   "i": 47,
   "scene": "voc",
   "sub": "人类第一次把【未来的风险与收益】，",
   "start": 248.854,
   "end": 252.347
  },
  {
   "i": 48,
   "scene": "voc",
   "sub": "打包成可以实时交易的标的。",
   "start": 252.447,
   "end": 255.535
  },
  {
   "i": 49,
   "scene": "years",
   "sub": "现代资本市场，只有【四百多年】。",
   "start": 256.935,
   "end": 261.059
  },
  {
   "i": 50,
   "scene": "candle",
   "sub": "你每天看到的K线，记录的从来不只是红与绿。",
   "start": 263.159,
   "end": 268.643
  },
  {
   "i": 51,
   "scene": "candle",
   "sub": "它是苏美尔神庙的【泥板】，",
   "start": 269.043,
   "end": 272.446
  },
  {
   "i": 52,
   "scene": "candle",
   "sub": "是唐代长安的【飞钱】，",
   "start": 272.546,
   "end": 275.04
  },
  {
   "i": 53,
   "scene": "candle",
   "sub": "是五千年来从未改变的【贪婪】、【恐惧】，",
   "start": 275.24,
   "end": 278.772
  },
  {
   "i": 54,
   "scene": "candle",
   "sub": "和信用博弈的数字符号。",
   "start": 278.872,
   "end": 281.769
  },
  {
   "i": 55,
   "scene": "consensus",
   "sub": "金融，是跨越【时间】分配资源；",
   "start": 283.669,
   "end": 287.205
  },
  {
   "i": 56,
   "scene": "consensus",
   "sub": "而价格，是所有人博弈之后的【共识】。",
   "start": 287.505,
   "end": 291.628
  }
 ],
